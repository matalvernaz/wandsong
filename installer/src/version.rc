#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WANDSONG_VERSION_NUM
 PRODUCTVERSION WANDSONG_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Wandsong contributors"
      VALUE "FileDescription", "Wandsong setup"
      VALUE "FileVersion", WANDSONG_VERSION_STR
      VALUE "InternalName", "WandsongSetup"
      VALUE "OriginalFilename", "WandsongSetup.exe"
      VALUE "ProductName", "Wandsong"
      VALUE "ProductVersion", WANDSONG_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
